<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Manager Dashboard' }) %>
<body>

  <%- include('../partials/sidebar', { role: 'manager' }) %>

  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Dashboard' }) %>

    <div class="content-inner">
      <h2>Welcome, <%= user.name || 'Manager' %></h2>
      <p>Brewery Drink Distribution Management System  overview of current operations.</p>

      <div class="stats-grid">
        <div class="stat-card">
          <h3>Total Inventory Categories</h3>
          <p><%= totalInventory %></p>
        </div>
        <div class="stat-card">
          <h3>Total Products</h3>
          <p><%= totalProducts %></p>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>