<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manager Dashboard</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

  <%- include('../partials/sidebar', { role: 'manager', currentPath: '/manager/dashboard' }) %>

  <div class="main-content">
    <div class="content-inner">
      <h2>Welcome, <%= user.name || 'Manager' %></h2>
      <p>Brewery Drink Distribution Management System  overview of current operations.</p>

      <div class="stats-grid">
        <div class="stat-card">
          <h3>Total Inventory Categories</h3>
          <p><%= totalInventory %></p>
        </div>
        <div class="stat-card">
          <h3>Total Products</h3>
          <p><%= totalProducts %></p>
        </div>
      </div>
    </div>
  </div>

</body>
</html>