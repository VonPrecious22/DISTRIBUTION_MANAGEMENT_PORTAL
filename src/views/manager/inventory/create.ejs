<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Create Inventory</title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/createinventory.css">
</head>

<body>
  <%- include('../../partials/sidebar', {
    role: 'manager',
    currentPath: '/manager/inventory'
  }) %>

  <main class="main-content">
    <div class="content-inner">
      <div class="create-inventory">

        <h2 class="page-title">Create Inventory</h2>

        <form
          action="/manager/inventory/create"
          method="POST"
          class="form-card"
        >
          <div class="form-group">
            <label for="name">Inventory Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Enter inventory name"
              required
            >
          </div>

          <div class="form-group">
            <label for="category">Category</label>

            <select id="category" name="category" required>
              <option value="">Select Category</option>
              <option value="Alcoholic">Alcoholic</option>
              <option value="Soft Drinks">Soft Drinks</option>
              <option value="Mineral Water">Mineral Water</option>
              <option value="Energy Drinks">Energy Drinks</option>
            </select>
          </div>

          <div class="form-group">
            <label for="description">Description</label>

            <textarea
              id="description"
              name="description"
              placeholder="Enter inventory description"
              required
            ></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-create">
              Create Inventory
            </button>

            <a
              href="/manager/inventory"
              class="btn-back"
            >
              Back to Inventory
            </a>
          </div>
        </form>

      </div>
    </div>
  </main>
</body>
</html>
