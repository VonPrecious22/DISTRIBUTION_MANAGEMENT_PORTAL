<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Inventory Details</title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/button.css">
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="/css/inventorydetail.css">
</head>

<body>
  <%- include('../../partials/sidebar', {
    role: 'manager',
    currentPath: '/manager/inventory'
  }) %>

  <main class="main-content">
    <div class="content-inner">

      <div class="detail-header">
        <h2 class="page-title">
          <%= result.inventory.category %>
        </h2>

        <a
          href="/manager/inventory/<%= result.inventory._id %>/products/create"
          class="btn btn-primary"
        >
          + Add Product
        </a>
      </div>

      <div class="quantity-summary">
        <span>Total Quantity:</span>
        <strong><%= result.totalQuantity %></strong>
      </div>

      <% if (products.length === 0) { %>

        <div class="empty-state">
          <p>No products have been added to this inventory yet.</p>
        </div>

      <% } else { %>

        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Product Name</th>
                <th scope="col">Quantity</th>
                <th scope="col">Price (FCFA)</th>
                <th scope="col">Action</th>
              </tr>
            </thead>

            <tbody>
              <% products.forEach(p => { %>
                <tr>
                  <td><%= p.name %></td>
                  <td><%= p.quantity %></td>
                  <td><%= p.price %></td>
                  <td>
                    <a
                      href="/manager/products/<%= p._id %>/edit"
                      class="btn btn-primary btn-edit"
                    >
                      Edit
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      <% } %>

    </div>
  </main>
</body>
</html>
