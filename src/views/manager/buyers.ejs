<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Buyers' }) %>
<body>

  <%- include('../partials/sidebar', { role: 'manager' }) %>

  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Buyers' }) %>

    <div class="content-inner">
      <a href="/manager/buyers/create">+ Create New Buyer</a>

      <table border="1" style="width: 100%; margin-top: 16px; border-collapse: collapse;">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Contact</th>
          <th>Status</th>
        </tr>
        <% buyers.forEach(buyer => { %>
          <tr>
            <td><%= buyer.name %></td>
            <td><%= buyer.email %></td>
            <td><%= buyer.contact %></td>
            <td><%= buyer.isActive ? "Active" : "Inactive" %></td>
          </tr>
        <% }) %>
      </table>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>