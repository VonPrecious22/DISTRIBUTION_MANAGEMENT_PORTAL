<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Orders' }) %>
<body>
  <%- include('../partials/sidebar', { role: 'manager' }) %>

  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Orders' }) %>

    <div class="content-inner">
      <% if (orders.length === 0) { %>
        <p>No orders have been received yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="data-table">
            <tr>
              <th>Date</th>
              <th>Buyer</th>
              <th>Total (FCFA)</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
            <% orders.forEach(order => { %>
              <tr>
                <td><%= order.createdAt.toLocaleDateString() %></td>
                <td><%= order.buyer ? order.buyer.name : 'Unknown' %></td>
                <td><%= order.totalAmount %></td>
                <td><span class="badge badge-<%= order.status.toLowerCase() %>"><%= order.status.replace('_', ' ') %></span></td>
                <td><a href="/manager/orders/<%= order._id %>">Review</a></td>
              </tr>
            <% }) %>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>