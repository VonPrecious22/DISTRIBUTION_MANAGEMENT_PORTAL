<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <table>
        <tr> <th>Name</th> <th> Quantity</th> <th> Price</th></tr>
        <% products.forEach(p =>{ %>
        <tr>
            <td> <=% p.name %> </td>
            <td> <=% p.quantity %> </td>
            <td> <=% p.price %></td>

        </tr>
        

        })
    </table>
</body>
</html>