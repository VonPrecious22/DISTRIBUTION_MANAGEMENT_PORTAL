<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Create Buyer' }) %>
<body>

  <%- include('../partials/sidebar', { role: 'manager' }) %>

  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Create Buyer Account' }) %>

    <div class="content-inner">
      <a href="/manager/buyers">← Back to Buyers List</a>

      <h2>Create Buyer Account</h2>
      <% if (error) { %><p style="color:red"><%= error %></p><% } %>

      <form action="/manager/buyers" method="POST">
        <div>
          <label>Full Name</label>
          <input type="text" name="name" required>
        </div>
        <div>
          <label>Email</label>
          <input type="email" name="email" required>
        </div>
        <div>
          <label>Contact</label>
          <input type="text" name="contact" required>
        </div>
        <div>
          <label>Temporary Password</label>
          <input type="password" name="password" required>
        </div>
        <button type="submit">Create Buyer</button>
      </form>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>