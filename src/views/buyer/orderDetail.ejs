<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Order Detail' }) %>
<body>
  <%- include('../partials/sidebar', { role: 'buyer' }) %>

  <div class="main-content">
    <%- include('../partials/topbar', { pageTitle: 'Order Detail' }) %>

    <div class="content-inner">
      <a href="/buyer/orders">← Back to My Orders</a>

      <h2>Order <%= order._id %></h2>
      <p>Placed on <%= order.createdAt.toLocaleDateString() %></p>
      <p>Status:
        <span class="badge badge-<%= order.status.toLowerCase() %>"><%= order.status.replace('_', ' ') %></span>
      </p>

      <div class="table-wrap">
        <table class="data-table">
          <tr><th>Item</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
          <% order.items.forEach(item => { %>
            <tr>
              <td><%= item.name %></td>
              <td><%= item.quantity %></td>
              <td><%= item.unitPrice %></td>
              <td><%= item.subtotal %></td>
            </tr>
          <% }) %>
        </table>
      </div>

      <p><strong>Total: <%= order.totalAmount %> FCFA</strong></p>

      <% if (order.pdfPath) { %>
        <p><a href="<%= order.pdfPath %>" target="_blank">Download order PDF</a></p>
      <% } %>

      <% if (order.status === 'PENDING') { %>
        <p>Your order has been sent to the manager and is waiting for approval.</p>
      <% } else if (order.status === 'PAYMENT_PENDING') { %>
        <p>Your order was approved. You can now make payment.</p>
        <%# The "Pay Now" button goes here once the payment step is built %>
      <% } else if (order.status === 'REJECTED') { %>
        <p>Sorry, this order was rejected by the manager.</p>
      <% } %>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>