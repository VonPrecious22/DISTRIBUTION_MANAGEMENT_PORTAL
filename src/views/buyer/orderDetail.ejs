<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order Detail</title>

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/table.css">
  <link rel="stylesheet" href="/css/badge.css">
  <link rel="stylesheet" href="/css/orderdetail.css">
</head>

<body>
  <%- include('../partials/sidebar', {
    role: 'buyer',
    currentPath: '/buyer/orders'
  }) %>

  <main class="main-content">
    <%- include('../partials/topbar', {
      pageTitle: 'Order Detail'
    }) %>

    <div class="content-inner order-detail-page">

      <a
        href="/buyer/orders"
        class="back-link"
      >
        ← Back to My Orders
      </a>

      <h2 class="order-heading">
        Order <%= order._id %>
      </h2>

      <div class="order-info">
        <p>
          <strong>Placed on:</strong>
          <%= order.createdAt.toLocaleDateString() %>
        </p>

        <p>
          <strong>Status:</strong>
          <span class="badge badge-<%= order.status.toLowerCase() %>">
            <%= order.status.replace('_', ' ') %>
          </span>
        </p>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Quantity</th>
              <th scope="col">Unit Price (FCFA)</th>
              <th scope="col">Subtotal (FCFA)</th>
            </tr>
          </thead>

          <tbody>
            <% order.items.forEach(item => { %>
              <tr>
                <td><%= item.name %></td>
                <td><%= item.quantity %></td>
                <td><%= item.unitPrice %></td>
                <td><%= item.subtotal %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <p class="order-total">
        <strong>
          Total: <%= order.totalAmount %> FCFA
        </strong>
      </p>

      <% if (order.pdfPath) { %>
        <a
          href="<%= order.pdfPath %>"
          target="_blank"
          class="pdf-link"
        >
          Download Order PDF
        </a>
      <% } %>

      <div class="status-message">
        <% if (order.status === 'PENDING') { %>

          <p>
            Your order has been sent to the manager and is waiting for approval.
          </p>

        <% } else if (order.status === 'PAYMENT_PENDING') { %>

          <p>
            Your order was approved. You can now make payment.
          </p>

        <% } else if (order.status === 'REJECTED') { %>

          <p>
            Sorry, this order was rejected by the manager.
          </p>

        <% } %>
      </div>

    </div>
  </main>

  <%- include('../partials/scripts') %>
</body>
</html>
